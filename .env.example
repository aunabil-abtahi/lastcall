APP_ENV=local
APP_URL=http://localhost/lastcall
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=replace_with_your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=replace_with_your_sandbox_store_password

# Ngrok Configuration (Optional: To expose local application to the internet)
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
# Optional public URL for IPN, for example a secure tunnel URL.
SSLCOMMERZ_IPN_URL=
